SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=sqlite:///instance/honeypot.db
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=true
# Keep false on Windows: the reloader's worker process can race the
# watcher process for the SQLite file handle. Flip to true for
# autoreload-on-save once that isn't an issue for you.
FLASK_USE_RELOADER=false
LOG_SUCCESSFUL_LOGINS=true
MAX_LOGGED_PASSWORD_LENGTH=255
